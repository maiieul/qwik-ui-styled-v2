{
  "name": "qwik-ui",
  "description": "Blank project with routing included",
  "engines": {
    "node": ">=22.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "test": "vitest run",
    "test.coverage": "vitest run --coverage.enabled true --coverage.provider=istanbul",
    "test.ui": "vitest --ui"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@floating-ui/dom": "^1.7.6",
    "@iconify/utils": "^3.1.3",
    "@oddbird/popover-polyfill": "^0.6.1",
    "@qds.dev/tools": "0.15.2",
    "@qds.dev/ui": "0.15.2",
    "@qwik.dev/core": "2.0.0-beta.37",
    "@qwik.dev/router": "2.0.0-beta.37",
    "@shikijs/rehype": "^4.1.0",
    "@shikijs/transformers": "^4.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/css-tree": "^2.3.11",
    "@types/node": "25.9.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-istanbul": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "clipboard-copy": "^4.0.1",
    "css-tree": "^3.2.1",
    "eslint": "9.39.2",
    "eslint-plugin-qwik": "https://pkg.pr.new/QwikDev/qwik/eslint-plugin-qwik@c5a4a1a",
    "fflate": "^0.8.3",
    "globals": "17.6.0",
    "playwright": "^1.60.0",
    "prettier": "3.8.3",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shiki": "^4.1.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-prettier": "^9.0.5",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0",
    "typescript-plugin-css-modules": "5.2.0",
    "vite": "7.3.3",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.1.7",
    "vitest-browser-qwik": "^0.3.8"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a",
  "nx": {}
}
